# Copy to .env.local for local dev. All of these are safe to expose in the
# browser bundle (the anon key is public by design; row level security is
# what protects data). On GitHub Pages set the two Supabase values as
# repository Variables, not in this file.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Only needed when previewing a GitHub Pages project-site build locally.
# The deploy workflow sets it for you.
# NEXT_PUBLIC_BASE_PATH=/2030-Projects
